{
  "name": "simobytedaemontool",
  "version": "0.2.0",
  "description": "SimoByteDaemon — AI coding tool by Simo",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/simo8902/deepcode-cli.git"
  },
  "bin": {
    "sbdt": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/cli.js",
    "docs/maintainer-guide.md",
    "docs/orchestration-contract.md",
    "docs/e2e-testing.md",
    "docs/prompts/**",
    "python/llama_cpp_worker.py",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "esbuild ./src/cli.tsx --bundle --platform=node --format=esm --target=node18 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --jsx=automatic --jsx-import-source=react --packages=external --log-override:empty-import-meta=silent",
    "build": "bun run typecheck && bun run bundle && bun -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "bun test src/tests/*.test.ts",
    "electron:build-main": "esbuild src/electron/main.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/electron/main.cjs --external:electron --jsx=automatic --jsx-import-source=react --define:import.meta.url=__filename",
    "electron:build-preload": "esbuild src/electron/preload.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/electron/preload.cjs --external:electron --define:import.meta.url=__filename",
    "electron:build": "bun run electron:build-main && bun run electron:build-preload && vite build",
    "electron:dev": "bun run electron:build-main && bun run electron:build-preload && vite",
    "electron:start": "electron dist/electron/main.cjs",
    "electron:run": "bun run electron:build-main && bun run electron:build-preload && vite build && electron dist/electron/main.cjs"
  },
  "dependencies": {
    "@hackylabs/deep-redact": "^3.0.5",
    "chalk": "^5.6.2",
    "ejs": "^5.0.2",
    "gradient-string": "^3.0.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "ink": "^7.0.1",
    "ink-gradient": "^4.0.0",
    "openai": "^6.35.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.4"
  }
}
